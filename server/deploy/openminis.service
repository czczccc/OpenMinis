[Unit]
Description=OpenMinis always-on agent server
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=minis
WorkingDirectory=/opt/openminis/server
EnvironmentFile=/etc/openminis.env
ExecStart=/usr/bin/node src/main.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
